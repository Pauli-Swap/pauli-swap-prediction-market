# Private QIP-55 devnet (quantum-ark), reached through `npm run vps:tunnel`
# in QuantumArk/infra/devnet. Copy to .env.devnet.
QRL_RPC_URL="http://127.0.0.1:8545"
QRL_CHAIN_ID=3151908
QRVM_NETWORK=devnet

DEPLOYER_MNEMONIC=""

# Address of the attester bot. Unset makes the deployer the attester.
ATTESTER_ADDRESS=""
# Season end for deploy.js, unix seconds. Season 1's announced end, so a
# redeploy keeps it; unset falls back to SEASON_DAYS (28) from now.
SEASON_ENDS_AT=1795627668

# Faucet operator: its own key (npm run gen:wallet), so claims never race the
# deployer / attester nonce. faucet-deploy.js funds it from FUNDER_ENV's
# DEPLOYER_MNEMONIC (default: the QuantumArk devnet operator).
FAUCET_MNEMONIC=""
FUNDER_ENV="../QuantumArk/infra/devnet/.env"
FAUCET_DRIP_QRL=50
FAUCET_COOLDOWN_SECONDS=86400
FAUCET_FUND_QRL=10000
# Faucet service (npm run faucet). Set FAUCET_TRUSTED_PROXY to the reverse
# proxy's address so its X-Forwarded-For is believed for the per-IP limit.
FAUCET_HOST="127.0.0.1"
FAUCET_PORT=8548
FAUCET_TRUSTED_PROXY=""
FAUCET_IP_LIMIT=5

# Attester bot (npm run attester): the indexer GraphQL endpoint it reads.
INDEXER_URL="http://127.0.0.1:4000/graphql"
# Address and port of the attester's GET /health (loop mode only).
ATTESTER_HEALTH_HOST="127.0.0.1"
ATTESTER_HEALTH_PORT=8549
