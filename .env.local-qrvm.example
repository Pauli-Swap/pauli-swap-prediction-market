# Local QIP-55 chain: docker run ... gqrl:local --dev (docs/QRVM.md, "Running it").
QRL_RPC_URL="http://127.0.0.1:8547"
QRVM_NETWORK=local-qrvm

# 34 word mnemonic of a funded account. The e2e test funds its throwaway
# trader wallets from it.
DEPLOYER_MNEMONIC=""

# Optional. Unset makes the deployer the attester.
ATTESTER_ADDRESS=""
